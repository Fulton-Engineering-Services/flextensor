+def _module_device(module: object) -> torch.device:
+    for candidate in (module, getattr(module, "model", None)):
+        if candidate is None:
+            continue
+        if hasattr(candidate, "parameters"):
+            parameter = next(candidate.parameters(), None)
+            if parameter is not None:
+                return parameter.device
+        if hasattr(candidate, "buffers"):
+            buffer = next(candidate.buffers(), None)
+            if buffer is not None:
+                return buffer.device
+    return torch.device("cuda")
+
